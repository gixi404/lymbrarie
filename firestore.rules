rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {
    match /lymbrarie_books/{book} {
      allow get, list, delete: if isAuthenticated() && isOwner();
      allow update: if isAuthenticated() && isOwner() && request.resource.data.owner == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner == request.auth.uid;
    }

    match /lymbrarie_users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /lymbrarie_suggestions/{suggestionId} {
      allow read: if true;
      allow create: if request.resource.data.text is string 
                   && request.resource.data.text.size() > 0 
                   && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }
  }

  function isAuthenticated() {
    return request.auth != null;
  }

  function isOwner() {
    return request.auth.uid == resource.data.owner;
  }

}